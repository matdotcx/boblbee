PortSystem          1.0
PortGroup           github 1.0

github.setup        matdotcx boblbee 1.0.0 v
github.tarball_from archive
revision            0

name                boblbee
categories          shells sysutils
maintainers         {matdotcx @matdotcx} openmaintainer
license             MIT
supported_archs     noarch
platforms           {darwin any}

description         Intelligent dotfiles management system for zsh with iCloud sync
long_description    boblbee is a collection of dotfiles, scripts, and widgets for \
                    setting up development environments on macOS and Ubuntu. Features \
                    include smart sync between iCloud Drive and git repositories, \
                    cross-platform shell configuration, Claude Code integration, and \
                    comprehensive system setup automation with git-aware prompts.

homepage            https://github.com/matdotcx/boblbee

checksums           rmd160  [checksums will be filled by port maintainer] \
                    sha256  [checksums will be filled by port maintainer] \
                    size    [size will be filled by port maintainer]

# Core dependencies required for basic functionality
depends_lib         port:zsh

depends_run         port:git \
                    port:curl \
                    port:python311 \
                    port:openssh \
                    port:coreutils

# Essential tools variant (recommended)
variant essentials description {Install essential development tools} {
    depends_run-append  port:zsh-syntax-highlighting \
                        port:zsh-autosuggestions \
                        port:tree \
                        port:fzf \
                        port:ripgrep \
                        port:gh \
                        port:nodejs18 \
                        port:npm8
}

# Development tools variant
variant development description {Install Python and development tools} {
    depends_run-append  port:py311-pytest \
                        port:ruff \
                        port:pre-commit \
                        port:htop \
                        port:eza
}

# Complete variant with all optional tools
variant complete description {Install all optional dependencies} {
    depends_run-append  port:zsh-syntax-highlighting \
                        port:zsh-autosuggestions \
                        port:tree \
                        port:fzf \
                        port:ripgrep \
                        port:gh \
                        port:nodejs18 \
                        port:npm8 \
                        port:py311-pytest \
                        port:ruff \
                        port:pre-commit \
                        port:htop \
                        port:eza \
                        port:tmux \
                        port:deno \
                        port:uv
}

# Default to essentials for most users
default_variants    +essentials

use_configure       no
build               {}

destroot {
    # Create destination directories
    xinstall -d ${destroot}${prefix}/share/${name}
    xinstall -d ${destroot}${prefix}/share/${name}/assets
    xinstall -d ${destroot}${prefix}/share/${name}/claude
    xinstall -d ${destroot}${prefix}/share/${name}/scripts
    xinstall -d ${destroot}${prefix}/share/${name}/templates
    xinstall -d ${destroot}${prefix}/bin
    
    # Install core files
    copy ${worksrcpath}/assets ${destroot}${prefix}/share/${name}/
    copy ${worksrcpath}/claude ${destroot}${prefix}/share/${name}/
    copy ${worksrcpath}/scripts ${destroot}${prefix}/share/${name}/
    copy ${worksrcpath}/templates ${destroot}${prefix}/share/${name}/
    
    # Install documentation
    xinstall -m 644 ${worksrcpath}/README.md ${destroot}${prefix}/share/${name}/
    xinstall -m 644 ${worksrcpath}/DOCUMENTATION.md ${destroot}${prefix}/share/${name}/
    xinstall -m 644 ${worksrcpath}/LICENSE ${destroot}${prefix}/share/${name}/
    
    # Make scripts executable
    fs-traverse script ${destroot}${prefix}/share/${name}/scripts {
        if {[file extension ${script}] eq ".sh"} {
            file attributes ${script} -permissions +x
        }
    }
    
    # Create wrapper script for easy access
    set wrapper [open ${destroot}${prefix}/bin/boblbee-setup w]
    puts ${wrapper} "#!/bin/sh"
    puts ${wrapper} "# boblbee setup wrapper"
    puts ${wrapper} "exec ${prefix}/share/${name}/scripts/index.sh \"\$@\""
    close ${wrapper}
    file attributes ${destroot}${prefix}/bin/boblbee-setup -permissions +x
    
    # Create bb-sync wrapper
    set bbsync [open ${destroot}${prefix}/bin/bb-sync w]
    puts ${bbsync} "#!/bin/sh"
    puts ${bbsync} "# boblbee sync wrapper"
    puts ${bbsync} "exec ${prefix}/share/${name}/scripts/zshrc-sync.sh \"\$@\""
    close ${bbsync}
    file attributes ${destroot}${prefix}/bin/bb-sync -permissions +x
}

post-install {
    ui_msg "boblbee has been installed to ${prefix}/share/${name}"
    ui_msg ""
    ui_msg "To set up boblbee on your system, run:"
    ui_msg "  boblbee-setup"
    ui_msg ""
    ui_msg "To sync configurations after setup:"
    ui_msg "  bb-sync"
    ui_msg ""
    ui_msg "Or manually run the setup script:"
    ui_msg "  cd ${prefix}/share/${name}/scripts && ./index.sh"
    ui_msg ""
    ui_msg "For GitHub integration, configure your token:"
    ui_msg "  security add-generic-password -a \${USER} -s gh-token -w [your-token]"
    ui_msg ""
    ui_msg "For more information, see:"
    ui_msg "  ${prefix}/share/${name}/README.md"
    ui_msg "  ${prefix}/share/${name}/DOCUMENTATION.md"
    ui_msg ""
    ui_msg "Note: The setup script will create symlinks and modify your"
    ui_msg "shell configuration. Please read the documentation first."
}

notes "
boblbee provides intelligent dotfiles management for zsh with the following features:

CORE FUNCTIONALITY:
• Smart sync between iCloud Drive and git repositories on macOS
• Cross-platform shell configuration (macOS and Ubuntu)
• Git-aware prompt with status indicators and branch information
• Comprehensive aliases and functions for development workflows
• SSH configuration management with keychain integration
• Command timing and execution feedback

INTEGRATION:
• Claude Code integration for AI assistant preferences
• GitHub CLI integration for repository management
• Python development tools (pytest, ruff, pre-commit)
• Node.js and npm for JavaScript development

DEPENDENCIES ANALYSIS:
Required: zsh, git, curl, python3, ssh, coreutils
Essential: zsh plugins, fzf, ripgrep, tree, gh, nodejs/npm
Optional: development tools, testing frameworks, additional utilities

INSTALLATION VARIANTS:
• Default (+essentials): Installs core dependencies and essential tools
• +development: Adds Python development tools
• +complete: Installs all optional dependencies

Run 'boblbee-setup' to begin the installation process.
Use 'bb-sync' to synchronise configurations after installation.

For development features: sudo port install ${name} +development
For all features: sudo port install ${name} +complete
"